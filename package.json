{
  "name": "farmforge",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild public/js/main.js --bundle --format=esm --platform=browser --target=es2022 --minify --outfile=public/build/game.js",
    "test": "node --test",
    "dev": "npm run build && npx wrangler dev",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@babylonjs/core": "9.29.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
